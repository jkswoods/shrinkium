{
  "title": "Shrinkium",
  "url": "https://jkswoods.github.io/shrinkium/",
  "base": "/shrinkium/",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "versions": {
    "current": "index",
    "position": "sidebar-top",
    "all": [
      {
        "id": "index",
        "dir": "docs",
        "label": "Choose Hytale version"
      },
      {
        "id": "hytale0.7",
        "dir": "versions/hytale0.7",
        "label": "Hytale 0.7 (latest)"
      }
    ]
  },
  "theme": {
    "appearance": "light",
    "customCss": [
      "/assets/publication.css",
      "/assets/brand.css"
    ]
  },
  "layout": {
    "optionsMenu": {
      "components": {
        "themeSwitch": false,
        "search": true
      }
    },
    "spa": false
  },
  "plugins": {
    "ai": {
      "enabled": false,
      "assistant": false
    },
    "analytics": false,
    "search": {
      "semantic": false
    },
    "git": {
      "commitHistory": false,
      "lastUpdated": false,
      "editLink": false,
      "branch": "docs"
    },
    "seo": {},
    "sitemap": {}
  },
  "markdown": {
    "breaks": false
  },
  "minify": false,
  "logo": {
    "light": "/assets/hytale0.7/brand/logo.png",
    "dark": "/assets/hytale0.7/brand/logo.png",
    "href": "/",
    "alt": "Shrinkium crystal emblem",
    "height": "48px"
  },
  "security": {
    "html": "allow"
  }
}
